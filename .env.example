# Every environment variable the project reads. Copy to .env (git-ignored) or export in your shell.
# Never commit real values: the real DAY1_SALT is printed on the team slip.

# --- docker compose / API ---
DAY1_SALT=                       # HMAC key for event and receipt signatures (spec 5.3); env only
JWT_SECRET=change-me-local-only  # HS256 key for login / RBAC tokens
POSTGRES_USER=league
POSTGRES_PASSWORD=league-local-only
POSTGRES_DB=league
# DATABASE_URL is assembled by docker-compose.yml from the three values above:
# DATABASE_URL=postgresql://league:league-local-only@db:5432/league

# --- tests (run_tests.sh sets these itself) ---
TEST_DATABASE_URL=postgresql://league:test@localhost:55433/league  # in-process test run
API_URL=                         # set e.g. http://localhost:8080 to run the same tests over HTTP

# FR-3.2 recordings -> MinIO (S3). Leave MINIO_URL empty to index recordings without uploading.
MINIO_URL=
MINIO_BUCKET=vod
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Address phones use to reach the API (LAN IP); exported QR images encode it. Empty = http://localhost:8080.
PUBLIC_BASE_URL=
